library(gratia)
library(cowplot)
library(gridExtra)
# Get the legend from one plot
legend <- cowplot::get_legend(
plot_t_v +
theme(
legend.position = "bottom",
legend.title = element_blank()
)
)
# Remove legends from all individual plots
plot_t_v <- plot_t_v + theme(legend.position = "none")
plot_v_t <- plot_v_t + theme(legend.position = "none")
plot_e_v <- plot_e_v + theme(legend.position = "none")
plot_v_e <- plot_v_e + theme(legend.position = "none")
plot_t_e <- plot_t_e + theme(legend.position = "none")
plot_e_t <- plot_e_t + theme(legend.position = "none")
# Arrange the six plots
plots <- gridExtra::arrangeGrob(
plot_t_v, plot_v_t,
plot_e_v, plot_v_e,
plot_t_e, plot_e_t,
ncol = 2,
nrow = 3
)
# Add ONE legend underneath
final_plot_all <- gridExtra::grid.arrange(
plots,
legend,
ncol = 1,
heights = c(1, 0.08)
)
library(patchwork)
final_plot_all <-
(plot_t_v | plot_v_t) /
(plot_e_v | plot_v_e) /
(plot_t_e | plot_e_t) +
plot_layout(guides = "collect") &
theme(legend.position = "bottom")
final_plot_all
