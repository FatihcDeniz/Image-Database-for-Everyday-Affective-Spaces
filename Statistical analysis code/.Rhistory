tick_size <- 13
color_palette <- c("black", "#CC79A7", "#CCC23B","#009E73", "red", "#D86002","#0072B2")
# c("model_1","model_2","model_3","model_4","model_5","model_6","model_7")
# Tense-Valence
predictions <- pred_scores(list(model1_t_v, model2_t_v, model3_t_v, model4_t_v, model5_t_v, model6_t_v, model7_t_v), data_all$valence, list("valence", "I_valence"), 2000)
plot_t_v <- plot_data(data_all, c('valence', 'tense'), c("Valence", "Tense Arousal"), alpha_point, alpha_hvline, tick_size, title_size)
plot_t_v <- add_lines(data = predictions, model_names = c("model_1","model_2","model_3","model_4","model_5","model_6","model_7"), plot = plot_t_v, x_col = "valence", color_palette = color_palette,size = size, alpha_val = alpha_val)
plot_t_v <- plot_t_v + labs(tag = "(a)") +
theme(plot.tag = element_text(size = 14, face = "bold"), plot.tag.position = c(0.02, 1.02), plot.margin = margin(t = 15, r = 5, b = 5, l = 5))
# Valence-Tense
predictions <- pred_scores(list(model1_v_t, model2_v_t, model3_v_t, model4_v_t, model5_v_t, model6_v_t, model7_v_t), data_all$tense, list("tense", "I_tense"), 2000)
plot_v_t <- plot_data(data_all, c('tense', 'valence'), c("Tense Arousal", "Valence"), alpha_point, alpha_hvline, tick_size, title_size)
plot_v_t <- add_lines(data = predictions, model_names = c("model_1","model_2","model_3","model_4","model_5","model_6","model_7"), plot = plot_v_t, x_col = "tense", color_palette = color_palette,size = size, alpha_val = alpha_val)
plot_v_t <- plot_v_t + labs(tag = "(b)") +
theme(plot.tag = element_text(size = 14, face = "bold"), plot.tag.position = c(0.02, 1.02), plot.margin = margin(t = 15, r = 5, b = 5, l = 5))
# Energetic - Valence
predictions <- pred_scores(list(model1_e_v, model2_e_v, model3_e_v, model4_e_v, model5_e_v, model6_e_v, model7_e_v), data_all$valence, list("valence", "I_valence"), 2000)
plot_e_v <- plot_data(data_all, c('valence', 'energetic'), c("Valence", "Energetic Arousal"), alpha_point, alpha_hvline, tick_size, title_size)
plot_e_v <- add_lines(data = predictions, model_names = c("model_1","model_2","model_3","model_4","model_5","model_6","model_7"), plot = plot_e_v, x_col = "valence", color_palette = color_palette,size = size, alpha_val = alpha_val)
plot_e_v <- plot_e_v + labs(tag = "(c)") +
theme(plot.tag = element_text(size = 14, face = "bold"), plot.tag.position = c(0.02, 1.02), plot.margin = margin(t = 15, r = 5, b = 5, l = 5))
# Valence - Energetic
predictions <- pred_scores(list(model1_v_e, model2_v_e, model3_v_e, model4_v_e, model5_v_e, model6_v_e, model7_v_e), data_all$energetic, list("energetic", "I_energetic"), 2000)
plot_v_e <- plot_data(data_all, c('energetic', 'valence'), c("Energetic Arousal", "Valence"), alpha_point, alpha_hvline, tick_size, title_size)
plot_v_e <- add_lines(data = predictions, model_names = c("model_1","model_2","model_3","model_4","model_5","model_6","model_7"), plot = plot_v_e, x_col = "energetic", color_palette = color_palette,size = size, alpha_val = alpha_val)
plot_v_e <- plot_v_e + labs(tag = "(d)") +
theme(plot.tag = element_text(size = 14, face = "bold"), plot.tag.position = c(0.02, 1.02), plot.margin = margin(t = 15, r = 5, b = 5, l = 5))
# Tense - Energetic
predictions <- pred_scores(list(model1_t_e, model2_t_e, model3_t_e, model4_t_e, model5_t_e, model6_t_e, model7_t_e), data_all$energetic, list("energetic", "I_energetic"), 2000)
plot_t_e <- plot_data(data_all, c('energetic', 'tense'), c("Energetic Arousal", "Tense Arousal"), alpha_point, alpha_hvline, tick_size, title_size)
plot_t_e <- add_lines(data = predictions, model_names = c("model_1","model_2","model_3","model_4","model_5","model_6","model_7"), plot = plot_t_e, x_col = "energetic", color_palette = color_palette,size = size, alpha_val = alpha_val)
plot_t_e <- plot_t_e + labs(tag = "(e)") +
theme(plot.tag = element_text(size = 14, face = "bold"), plot.tag.position = c(0.02, 1.02), plot.margin = margin(t = 15, r = 5, b = 5, l = 5))
# Energetic - Tense
predictions <- pred_scores(list(model1_e_t, model2_e_t, model3_e_t, model4_e_t, model5_e_t, model6_e_t, model7_e_t), data_all$tense, list("tense", "I_tense"), 2000)
plot_e_t <- plot_data(data_all, c('tense', 'energetic'), c("Tense Arousal", "Energetic Arousal"), alpha_point, alpha_hvline, tick_size, title_size)
plot_e_t <- add_lines(data = predictions, model_names = c("model_1","model_2","model_3","model_4","model_5","model_6","model_7"), plot = plot_e_t, x_col = "tense", color_palette = color_palette,size = size, alpha_val = alpha_val)
plot_e_t <- plot_e_t + labs(tag = "(f)") +
theme(plot.tag = element_text(size = 14, face = "bold"), plot.tag.position = c(0.02, 1.02), plot.margin = margin(t = 15, r = 5, b = 5, l = 5))
final_plot_all <- gridExtra::grid.arrange(plot_t_v,plot_v_t, plot_e_v, plot_v_e, plot_t_e, plot_e_t, ncol=2, nrow=3)
ggsave(file=".\\Visualizations\\affective_space_plot_supplamentary.svg", plot=final_plot_all, width=10, height=10)
gc()
