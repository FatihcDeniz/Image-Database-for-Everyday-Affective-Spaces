plot_t_e <- plot_t_e + labs(tag = "(e)") +
theme(plot.tag = element_text(size = 14, face = "bold"), plot.tag.position = c(0.02, 1.02), plot.margin = margin(t = 15, r = 5, b = 5, l = 5))
# Energetic - Tense
predictions <- pred_scores(list(model1_e_t, model2_e_t, model3_e_t, model4_e_t, model5_e_t, model6_e_t, model7_e_t), data_all$tense, list("tense", "I_tense"), 2000)
plot_e_t <- plot_data(data_all, c('tense', 'energetic'), c("Tense Arousal", "Energetic Arousal"), alpha_point, alpha_hvline, tick_size, title_size)
plot_e_t <- plot_e_t + labs(tag = "(f)") +
theme(plot.tag = element_text(size = 14, face = "bold"), plot.tag.position = c(0.02, 1.02), plot.margin = margin(t = 15, r = 5, b = 5, l = 5))
final_plot_all <- gridExtra::grid.arrange(plot_t_v,plot_v_t, plot_e_v, plot_v_e, plot_t_e, plot_e_t, ncol=2, nrow=3)
library(patchwork)
