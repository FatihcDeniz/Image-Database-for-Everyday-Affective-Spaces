add_lines <- function(data, model_names, plot, x_col = "valence", color_palette,size, alpha_val) {
for (i in 1:7) {
nm <- paste0("model_", i)
if (nm %in% model_names) {
plot <- plot +
geom_line(data = data,
aes_string(x = x_col, y = nm), color = color_palette[i], size = size, alpha = alpha_val)
}
}
plot
}
